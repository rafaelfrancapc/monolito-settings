#!/usr/bin/python3 -I
"""Privileged, fixed-purpose realmd adapter. Installed root:root, mode 0755.
Input: one bounded JSON object on stdin. Never emits command output or secrets.
Exit 10 means domain join succeeded but local configuration needs repair.
"""
import configparser
import io
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

SSSD = Path('/etc/sssd/sssd.conf')
KRB5 = Path('/etc/krb5.conf')
BACKUP = Path('/var/lib/monolito/backups')


def valid_domain(value):
    return (isinstance(value, str) and len(value) <= 253 and '.' in value
            and all(re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', p)
                    for p in value.split('.')))


def validate(data):
    if not isinstance(data, dict) or set(data) - {'allow_rc4'} != {
        'domain', 'administrator', 'password', 'unqualified_names', 'allow_weak_crypto'
    }:
        raise ValueError('request')
    if not valid_domain(data['domain']):
        raise ValueError('domain')
    admin = data['administrator']
    if not isinstance(admin, str) or not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.@\\-]{0,255}', admin):
        raise ValueError('administrator')
    password = data['password']
    if not isinstance(password, str) or not password or len(password) > 4096 or any(c in password for c in '\n\r\0'):
        raise ValueError('password')
    data.setdefault('allow_rc4', False)
    for key in ['unqualified_names', 'allow_weak_crypto', 'allow_rc4']:
        if type(data[key]) is not bool:
            raise ValueError(key)
    return data


def sssd_config(text, domain, unqualified):
    conf = configparser.RawConfigParser(interpolation=None, strict=True)
    conf.read_string(text)
    sections = [s for s in conf.sections() if s.lower() == 'domain/' + domain.lower()]
    if len(sections) != 1:
        raise ValueError('Missing or ambiguous SSSD domain section')
    conf.set(sections[0], 'use_fully_qualified_names', 'false' if unqualified else 'true')
    out = io.StringIO()
    conf.write(out)
    return out.getvalue()


def kerberos_config(text, allow_weak_crypto=True, allow_rc4=False):
    # Preserve all unrelated Kerberos syntax, including nested realm stanzas.
    lines = text.splitlines(keepends=True)
    options = {}
    if allow_weak_crypto:
        options['allow_weak_crypto'] = 'true'
    if allow_rc4:
        options['allow_rc4'] = 'true'
    if not options:
        return text
    additions = ''.join(f'    {key} = {value}\n' for key, value in options.items())
    sections = [(i, re.match(r'^\s*\[([^]]+)\]', line)) for i, line in enumerate(lines)]
    headers = [(i, m.group(1).strip().lower()) for i, m in sections if m]
    starts = [i for i, name in headers if name == 'libdefaults']
    if len(starts) > 1:
        raise ValueError('Ambiguous libdefaults')
    if not starts:
        return text.rstrip() + '\n\n[libdefaults]\n' + additions
    start = starts[0]
    end = next((i for i, _ in headers if i > start), len(lines))
    segment = [s for s in lines[start + 1:end]
               if not any(re.match(r'^\s*' + key + r'\s*=', s, re.I) for key in options)]
    return ''.join(lines[:start + 1]).rstrip('\n') + '\n' + additions + ''.join(segment) + ''.join(lines[end:])


def safe_read(path):
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise ValueError('Unsafe configuration file')
    return path.read_text(), stat.S_IMODE(st.st_mode)


def atomic_write(path, text, mode):
    fd, temp = tempfile.mkstemp(prefix='.monolito-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            os.fchmod(f.fileno(), mode)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def command(args, **kwargs):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                          timeout=120, check=True, env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}, **kwargs)


def join(data):
    # Serialize all helper requests, including preflight and rollback.
    import fcntl
    lockfd = os.open('/run/monolito-directory.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lockfd, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return join_locked(data)


def join_locked(data):
    for binary in ['realm', 'adcli', 'sssd', 'sssctl', 'systemctl']:
        if not shutil.which(binary, path='/usr/sbin:/usr/bin:/sbin:/bin'):
            raise ValueError('Missing dependency')
    # This operation joins a new host. It never silently changes an existing membership.
    if command(['/usr/bin/realm', 'list', '--name-only']).stdout.strip():
        raise ValueError('Already joined')
    BACKUP.mkdir(parents=True, exist_ok=True, mode=0o700)
    if BACKUP.is_symlink() or BACKUP.stat().st_uid != 0:
        raise ValueError('Unsafe backup path')
    os.chmod(BACKUP, 0o700)
    backup = Path(tempfile.mkdtemp(prefix='join-', dir=BACKUP))
    old_krb = None
    old_sssd = None
    joined = False
    try:
        if data['allow_weak_crypto'] or data.get('allow_rc4', False):
            old_krb = safe_read(KRB5)
            atomic_write(backup / 'krb5.conf', old_krb[0], 0o600)
            atomic_write(KRB5, kerberos_config(old_krb[0], data['allow_weak_crypto'], data.get('allow_rc4', False)), old_krb[1])
        command(['/usr/bin/realm', 'join', '--client-software=sssd', '--membership-software=adcli',
                 '--user=' + data['administrator'], data['domain']], input=(data['password'] + '\n').encode())
        joined = True
        old_sssd = safe_read(SSSD)
        atomic_write(backup / 'sssd.conf', old_sssd[0], 0o600)
        atomic_write(SSSD, sssd_config(old_sssd[0], data['domain'], data['unqualified_names']), 0o600)
        command([shutil.which('sssctl', path='/usr/sbin:/usr/bin:/sbin:/bin'), 'config-check'])
        command(['/usr/bin/systemctl', 'restart', 'sssd'])
        return 0
    except Exception:
        if old_sssd:
            atomic_write(SSSD, old_sssd[0], 0o600)
            try:
                command(['/usr/bin/systemctl', 'restart', 'sssd'])
            except Exception:
                pass
        # Do not undo successful domain membership or its required crypto setting.
        if old_krb and not joined:
            atomic_write(KRB5, old_krb[0], old_krb[1])
        return 10 if joined else 1
    finally:
        data['password'] = ''


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 1
    try:
        payload = sys.stdin.buffer.read(16385)
        if len(payload) > 16384:
            return 1
        return join(validate(json.loads(payload)))
    except Exception:
        return 1


if __name__ == '__main__':
    sys.exit(main())
